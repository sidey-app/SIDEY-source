---
import DownloadLegalNotice from "./DownloadLegalNotice.astro";
import type { Locale } from "../i18n/landing";

interface Props {
  label: string;
  platform: "macos" | "windows";
  href?: string;
  id?: string;
  describedBy?: string;
  disabled?: boolean;
  showActionIcon?: boolean;
  legalNotice?: boolean;
  locale?: Locale;
  appStoreLink?: boolean;
}

const { label, platform, href, id, describedBy, disabled = false, showActionIcon = true, legalNotice = false, locale = "ko", appStoreLink = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const tooltipId = legalNotice ? `${id ?? `${platform}-download`}-license` : undefined;
const accessibleDescription = [describedBy, tooltipId].filter(Boolean).join(" ") || undefined;
---

<span class="download-license-wrap">
  {disabled ? (
    <button class:list={["button", "button-secondary", "download-button", !showActionIcon && "download-button-simple"]} id={id} type="button" disabled aria-describedby={accessibleDescription}>
      <img class:list={["download-platform-logo", `download-platform-logo-${platform}`]} src={`${base}assets/platforms/${platform}-light.svg`} alt="" width="18" height="18">
      <span class="download-button-label">{label}</span>
      {showActionIcon && <span class="download-button-circle" aria-hidden="true"><span class="material-symbols-rounded">download</span></span>}
    </button>
  ) : (
    <a class:list={["button", "button-primary", "download-button", !showActionIcon && "download-button-simple"]} id={id} href={href} data-app-store-link={appStoreLink ? true : undefined} aria-describedby={accessibleDescription}>
      <img class:list={["download-platform-logo", `download-platform-logo-${platform}`]} src={`${base}assets/platforms/${platform}-light.svg`} alt="" width="18" height="18">
      <span class="download-button-label">{label}</span>
      {showActionIcon && <span class="download-button-circle" aria-hidden="true"><span class="material-symbols-rounded">download</span></span>}
    </a>
  )}
  {tooltipId && <DownloadLegalNotice id={tooltipId} locale={locale} />}
</span>
