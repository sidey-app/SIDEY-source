---
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import LandingFooter from "../components/LandingFooter.astro";
import SiteTheme from "../components/SiteTheme.astro";
import { localizeCanonicalPath, supportedLocales, type Locale } from "../i18n/landing";
import "../styles/styles.scss";

interface Props { locale: Locale; title: string; description: string; canonicalPath: string; }
const { locale, title, description, canonicalPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const localePaths = supportedLocales.map((code) => ({
  code,
  path: localizeCanonicalPath(canonicalPath, code),
}));
const neutralPath = canonicalPath.replace(/^(ko|en|ja|zh-hant)\//, "");
const skipLabels: Record<Locale, string> = { ko: "본문으로 건너뛰기", en: "Skip to content", ja: "本文へスキップ", "zh-Hant": "跳到主要內容" };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SiteTheme />
    <SiteFonts />
    <link rel="canonical" href={new URL(`${base}${canonicalPath}`, Astro.site)}>
    {localePaths.map(({ code, path }) => <link rel="alternate" hreflang={code} href={new URL(`${base}${path}`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`${base}${neutralPath}`, Astro.site)}>
    <link rel="icon" type="image/png" href={`${base}assets/app-icon.png`}>
  </head>
  <body class="info-page route-content-enter">
    <a class="skip-link" href="#main">{skipLabels[locale]}</a>
    <SiteHeader locale={locale} current="whats-new" />
    <main id="main"><slot /></main>
    <LandingFooter locale={locale} />
    <script src={`${base}assets/script.js`} defer is:inline></script>
  </body>
</html>
