---
import "../styles/styles.scss";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFonts from "../components/SiteFonts.astro";
import SiteTheme from "../components/SiteTheme.astro";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src https://whtejsviizgejauasqqt.supabase.co; base-uri 'self'">
    <title>결제 결과 · SIDEY</title>
    <SiteTheme />
    <SiteFonts />
    <link rel="icon" type="image/png" href="../assets/app-icon.png">
    <script src="../assets/checkout-result.js?v=c040b965d6cb" type="module" is:inline></script>
  </head>
  <body class="checkout-body">
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <SiteHeader rootPath="../" />
    <main class="checkout-shell" id="main">
      <section class="checkout-card checkout-result-card" aria-labelledby="result-title">
        <div class="checkout-state">
          <span id="result-icon" class="checkout-state-icon" aria-hidden="true">✦</span>
          <h1 id="result-title">결제 결과를 확인하고 있어요.</h1>
          <p id="result-message">잠시만 기다려주세요.</p>
          <a class="button button-secondary checkout-result-link" href="../ko/store/">상품 안내 보기</a>
        </div>
      </section>
    </main>
  </body>
</html>
