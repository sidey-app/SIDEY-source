      "productID": "character_starlight_upalupa_solo",
      "referenceName": "별빛 우파루파",
      "displayPrice": "2200",
      "localizations": [
        {
          "description": "길 잃은 별 하나를 데려왔어요. 잘 때도 품에 꼭 안고 잔대요.",
          "displayName": "별빛 우파루파",
          "locale": "ko_KR"
        },
        {
          "description": "An axolotl who hugs a lost star to sleep.",
          "displayName": "Starlight Axolotl",
          "locale": "en_US"
        },
        {
          "description": "迷子の星を抱いて眠るウーパールーパーです。",
          "displayName": "星明かりのウーパールーパー",
          "locale": "ja"
        },
        {
          "description": "抱著迷路小星星入睡的六角恐龍。",
          "displayName": "星光六角恐龍",
          "locale": "zh_Hant"
