          "locale": "zh_Hant"
        }
      ]
    },
    {
      "familyShareable": false,
      "internalID": "02000000-0000-4000-8000-000000000040",
      "type": "NonConsumable",
      "productID": "throwable_starlight_orb",
      "referenceName": "별빛 우파루파의 별빛 구슬",
