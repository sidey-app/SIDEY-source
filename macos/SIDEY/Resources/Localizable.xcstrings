            "value": "刪除"
          }
        }
      }
    },
    "settings.account.delete.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your profile, messages, and group memberships. Purchase records may be kept separately from your account where required for accounting and fraud prevention."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、メッセージ、グループのメンバーシップを削除します。購入記録は、会計および不正利用防止に必要な範囲でアカウントと分けて保持される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 메시지, 그룹 멤버십을 삭제합니다. 구매 기록은 회계·부정 사용 방지에 필요한 범위에서 계정과 분리해 보관될 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除你的個人檔案、訊息和群組成員資格。基於會計與防止詐騙所需，購買紀錄可能會與帳號分開保存。"
          }
        }
      }
    },
    "settings.account.delete.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type “DELETE” to confirm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のため「削除」と入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 위해 ‘탈퇴’ 입력"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入「刪除」以確認"
          }
        }
      }
    },
