{
  "sourceLanguage": "en",
  "strings": {
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t delete your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 탈퇴에 실패했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除帳號。"
          }
        }
      }
    },
    "account_delete.error.request_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the account deletion request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除リクエストを完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 삭제 요청을 완료하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成刪除帳號的要求。"
          }
        }
      }
    },
    "apple_auth.error.missing_authorization_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new Apple authorization code is required to delete your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除するには、新しいApple認証コードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 탈퇴에는 새로운 Apple 인증 코드가 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳號需要新的 Apple 授權碼。"
          }
        }
      }
    },
    "apple_auth.error.missing_identity_token": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sign in with Apple response did not include an identity token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインの応答にidentity tokenが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 응답에 identity token이 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入的回應中沒有 identity token。"
          }
        }
      }
    },
    "apple_auth.error.missing_request_nonce": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sign in with Apple response did not include the request nonce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインの応答にリクエストnonceが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 응답에 요청 nonce가 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入的回應中沒有要求 nonce。"
          }
        }
      }
    },
    "auth.apple.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store version requires Sign in with Apple to restore purchases and protect your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の復元とアカウント保護のため、App Store版ではAppleでのサインインが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 복원과 계정 보호를 위해 App Store 버전은 Apple 로그인이 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了還原購買項目並保護帳號，App Store 版本需要使用 Apple 登入。"
          }
        }
      }
    },
    "auth.apple.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start SIDEY with Apple"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleでSIDEYを始める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 SIDEY 시작하기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 開始使用 SIDEY"
          }
        }
      }
    },
    "auth.apple.verifying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying sign-in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを確認中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 확인 중"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認登入"
          }
        }
      }
    },
    "auth.apple_sign_in.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign in with Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인에 실패했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 Apple 登入。"
          }
        }
      }
    },
    "backend.connect.failed_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect to the server: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 연결 실패: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至伺服器：%@"
          }
        }
      }
    },
    "backend.connection.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中"
          }
        }
      }
    },
    "backend.connection.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection Error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続エラー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 오류"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線錯誤"
          }
        }
      }
    },
    "backend.connection.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中"
          }
        }
      }
    },
    "backend.connection.online": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        }
      }
    },
    "backend.error.already_member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve already joined this group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに参加しているグループです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 참여 중인 그룹입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已加入這個群組。"
          }
        }
      }
    },
    "backend.error.authentication_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No authentication session is available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証セッションがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 세션이 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有驗證工作階段。"
          }
        }
      }
    },
    "backend.error.current_user_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify the current user."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のユーザー情報を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용자 정보를 확인하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認目前的使用者資訊。"
          }
        }
      }
    },
    "backend.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the request. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成要求，請稍後再試。"
          }
        }
      }
    },
    "backend.error.invalid_invite_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the invite code and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드를 다시 확인해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認邀請碼後再試一次。"
          }
        }
      }
    },
    "backend.error.invalid_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a message with no more than 200 characters and 3 lines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは200文字・3行以内で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 200자·3줄 이하로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息請勿超過 200 個字元及 3 行。"
          }
        }
      }
    },
    "backend.error.invalid_profile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nickname of 2–8 characters without line breaks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームは改行なしの2〜8文字で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닉네임은 줄바꿈 없이 2~8자로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暱稱請輸入 2 至 8 個字元，且不要換行。"
          }
        }
      }
    },
    "backend.error.invalid_room_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a group name of 1–20 characters without line breaks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ名は改行なしの1〜20文字で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 이름은 줄바꿈 없이 1~20자로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組名稱請輸入 1 至 20 個字元，且不要換行。"
          }
        }
      }
    },
    "backend.error.invalid_timestamp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the message time from the server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのメッセージ時刻を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 메시지 시각을 해석하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析伺服器上的訊息時間。"
          }
        }
      }
    },
    "backend.error.invite_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many invite code attempts. Try again in 10 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードの試行回数が多すぎます。10分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드 시도가 너무 많습니다. 10분 뒤 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試邀請碼的次數過多，請在 10 分鐘後再試。"
          }
        }
      }
    },
    "backend.error.malformed_response": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the server response."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーからの応答を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답 형식을 해석하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析伺服器回應。"
          }
        }
      }
    },
    "backend.error.member_limit_reached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This group is already full with %lld member."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This group is already full with %lld members."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このグループはすでに%lld人で満員です。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このグループはすでに%lld人で満員です。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 그룹은 이미 %lld명으로 가득 찼습니다."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 그룹은 이미 %lld명으로 가득 찼습니다."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "這個群組已有 %lld 位成員，名額已滿。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "這個群組已有 %lld 位成員，名額已滿。"
                }
              }
            }
          }
        }
      }
    },
    "backend.error.member_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find the member to remove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するメンバーが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 멤버를 찾지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到要移除的成員。"
          }
        }
      }
    },
    "backend.error.membership_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only members of this group can do that."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はグループのメンバーのみ実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 멤버만 이 작업을 할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這個群組的成員可以執行此操作。"
          }
        }
      }
    },
    "backend.error.message_receive_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t receive a message. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを受信できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 받지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法接收訊息，請稍後再試。"
          }
        }
      }
    },
    "backend.error.no_active_room": {
      "extractionState": "manual",
      "localizations": {
