        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Firebase 실시간 전환 상태를 안전하게 저장할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
