          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可傳送訊息的群組。"
          }
        }
      }
    },
    "backend.error.owner_cannot_remove_self": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group owner can’t remove themselves."
          }
