    "invite.error.not_stored_on_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full invite code for this group isn’t stored on this device. For security, it can’t be recovered from the database hash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループの完全な招待コードはこのデバイスに保存されていません。セキュリティ上、データベースのハッシュからは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 이 그룹의 초대 코드 원문이 없습니다. 보안상 데이터베이스의 해시에서는 복구할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置未儲存這個群組的完整邀請碼。基於安全考量，無法從資料庫雜湊值還原。"
          }
        }
      }
    },
