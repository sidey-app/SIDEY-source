    },
    "realtime.rollout.error.contract_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Firebase real-time contract enabled by the server doesn’t match this app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーで有効化されたFirebaseのリアルタイム契約がこのアプリと一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 활성화한 Firebase 실시간 계약이 이 앱과 일치하지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器啟用的 Firebase 即時合約與此 App 不符。"
          }
        }
      }
    },
    "realtime.rollout.error.enabled_policy_unavailable": {
