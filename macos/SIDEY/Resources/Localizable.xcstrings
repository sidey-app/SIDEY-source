    },
    "store.footer.app_store.refund": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds and billing inquiries follow Apple’s App Store policies and procedures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金や支払いに関するお問い合わせには、AppleのApp Storeポリシーと手続きが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불과 결제 문의는 Apple의 App Store 정책과 절차를 따릅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
