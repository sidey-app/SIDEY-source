    "settings.display.quiet_mode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide message text and typing dots while keeping connection status and unread counts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ本文と入力中の点を隠し、接続状態と未読数は表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 본문과 타이핑 점을 숨기고 연결 상태와 미확인 수는 유지합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏訊息內容與輸入提示點，同時保留連線狀態與未讀數。"
          }
        }
      }
    },
    "settings.display.quiet_mode.title": {
