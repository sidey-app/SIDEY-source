    "settings.display.offline_members.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show offline friends as sleeping characters with a red status dot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインの友だちも、眠っているキャラクターと赤いステータス点で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접속하지 않은 친구도 잠든 캐릭터와 빨간 상태 점으로 표시합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線的朋友也會顯示為睡著的角色，並帶有紅色狀態點。"
          }
        }
      }
    },
    "settings.display.offline_members.title": {
