      }
    },
    "backend.error.room_resync_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t synchronize the group state. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの状態を同期できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 상태를 동기화하지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法同步群組狀態，請稍後再試。"
          }
        }
      }
    },
    "backend.error.session_recovery_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t restore your previous sign-in session. No new account was created. Sign in again or contact support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のサインインセッションを復元できませんでした。新しいアカウントは作成されていません。もう一度サインインするか、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 로그인 세션을 복구하지 못했습니다. 새 계정은 만들지 않았으니 다시 로그인하거나 지원을 요청해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復先前的登入工作階段。系統並未建立新帳號，請重新登入或聯絡支援。"
          }
        }
      }
    },
    "backend.error.stale_realtime_epoch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group permissions changed, so the real-time connection needs to be refreshed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの権限が変更されたため、リアルタイム接続を更新する必要があります。"
