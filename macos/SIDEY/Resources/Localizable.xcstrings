    "group.join.keychain_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You joined the group, but the invite code couldn’t be saved to Keychain. Save the code you received somewhere safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループには参加しましたが、招待コードをキーチェーンに保存できませんでした。受け取ったコードを別の安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹에는 참여했지만 초대 코드를 키체인에 저장하지 못했습니다. 받은 코드를 따로 보관해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已加入群組，但無法將邀請碼儲存至鑰匙圈。請另外妥善保存收到的邀請碼。"
          }
        }
      }
    },
    "group.join.realtime_grant_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You joined the group, but the new real-time access couldn’t be verified yet: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループには参加しましたが、新しいリアルタイム権限をまだ確認できません：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹에는 참여했지만 새 실시간 권한을 확인 중입니다: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已加入群組，但仍無法確認新的即時存取權限：%@"
          }
        }
      }
    },
    "group.leave.confirmation.last_member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because you’re the last member, the group and all messages will be permanently deleted and can’t be recovered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のメンバーのため、グループとすべてのメッセージは完全に削除され、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 멤버이므로 그룹과 모든 메시지가 영구 삭제되며 복구할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於你是最後一位成員，群組和所有訊息將永久刪除且無法復原。"
          }
        }
      }
    },
    "group.leave.confirmation.member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll no longer be able to access the group or its existing messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループとこれまでのメッセージにはアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹과 기존 메시지에 더 이상 접근할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將無法再存取此群組及既有訊息。"
          }
        }
      }
    },
    "group.leave.confirmation.owner_transfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ownership will transfer to the earliest remaining member, and you’ll no longer be able to access the group or its existing messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループオーナーは残っているメンバーのうち最初に参加した人へ移り、グループとこれまでのメッセージにはアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 참여한 남은 멤버에게 방장이 이전되며, 그룹과 기존 메시지에 더 이상 접근할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組擁有權將移交給現有成員中最早加入的人，而你將無法再存取此群組及既有訊息。"
          }
        }
      }
    },
