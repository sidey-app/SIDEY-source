        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時連線尚未就緒。"
          }
        }
      }
    },
    "backend.error.room_limit_reached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person can use up to 5 groups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1人につき最大5個のグループを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 사용자는 그룹을 최대 5개까지 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位使用者最多可以使用 5 個群組。"
          }
