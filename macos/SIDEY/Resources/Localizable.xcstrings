    "realtime.rollout.error.cache_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t securely save the Firebase real-time rollout status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Firebaseのリアルタイムrollout状態を安全に保存できませんでした。"
