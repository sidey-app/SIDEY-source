    "groups.invite_code.rotate.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke the potentially exposed code and issue one new 128-bit code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "漏えいした可能性のある以前のコードを無効にし、新しい128ビットコードを1つ発行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노출 위험이 있던 이전 코드를 폐기하고 새 128-bit 코드를 한 번 발급합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷可能已外洩的舊代碼，並產生一組新的 128 位元代碼。"
          }
        }
      }
    },
    "groups.join.invite_code.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you enter an invite code, the server checks membership and the member limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードを入力すると、サーバーがメンバーシップと人数制限を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드를 입력하면 서버에서 멤버십과 인원 제한을 확인합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入邀請碼後，伺服器會檢查成員資格與人數上限。"
          }
        }
      }
    },
