    "invite.error.revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous invite code for this group has been revoked. The group owner must issue a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループの以前の招待コードは無効になりました。グループオーナーが新しいコードを発行する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 이전 초대 코드는 폐기됐습니다. 방장이 새 코드를 발급해야 합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個群組先前的邀請碼已撤銷，群組擁有者需要發出新的邀請碼。"
          }
        }
      }
    },
    "invite.rotate.keychain_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new code was issued, but it couldn’t be saved to Keychain. Save the code shown now somewhere safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコードは発行されましたが、キーチェーンに保存できませんでした。現在表示されているコードを別の安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 코드는 발급됐지만 키체인에 저장하지 못했습니다. 지금 표시된 코드를 따로 보관해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的邀請碼已發出，但無法儲存至鑰匙圈。請另外妥善保存目前顯示的邀請碼。"
          }
        }
      }
    },
