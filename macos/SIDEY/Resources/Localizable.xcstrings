    "store.footer.app_store.entitlement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple processes purchases, and access is added to your account after server verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入はAppleが処理し、サーバーでの検証後に利用権がアカウントへ反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 Apple이 처리하며 서버 검증 뒤 계정에 사용권이 반영됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買由 Apple 處理，經伺服器驗證後，使用權會加入您的帳號。"
          }
        }
      }
    },
    "store.footer.app_store.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices and payments are shown and processed by the App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格の表示と支払い処理はApp Storeで行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
