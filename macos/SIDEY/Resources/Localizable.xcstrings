    "keychain.transition.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY uses macOS Keychain to securely store and retrieve your sign-in session and group invite codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEYはサインイン情報とグループの招待コードを安全に保存・取得するためにmacOSキーチェーンを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY는 로그인 상태와 그룹 초대 코드를 안전하게 보관하고 불러오기 위해 macOS 키체인을 사용합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY 使用 macOS 鑰匙圈，安全地儲存及取得登入狀態與群組邀請碼。"
          }
        }
      }
    },
    "keychain.transition.migration_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time SIDEY loads information saved by an earlier version, macOS may ask for your Mac login password. To avoid being asked again, select “Always Allow” in the macOS dialog that follows. If you select “Allow,” the dialog may appear several more times or appear again the next time you open SIDEY, depending on the saved information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のバージョンで保存した情報を初めて読み込む際に、Macのログインパスワードを求められることがあります。次回から確認されないようにするには、続いて表示されるmacOSのダイアログで「常に許可」を選択してください。「許可」を選ぶと、保存されている情報に応じてダイアログが数回表示されたり、次回の起動時に再び表示されたりすることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전에서 저장한 정보를 처음 불러올 때 Mac 로그인 암호를 요청할 수 있습니다. 다음부터 묻지 않도록 하려면 이어서 표시되는 macOS 창에서 ‘항상 허용’을 선택해 주세요. ‘허용’을 선택하면 저장된 정보에 따라 창이 몇 차례 더 나타나거나 다음 실행 때 다시 표시될 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次載入舊版本儲存的資訊時，macOS 可能會要求輸入 Mac 登入密碼。若不想下次再被詢問，請在接著顯示的 macOS 視窗中選擇「永遠允許」。若選擇「允許」，視已儲存的資訊而定，視窗可能會再顯示數次，或在下次啟動時再次出現。"
          }
        }
      }
    },
    "keychain.transition.privacy_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY does not see or store the password you enter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEYが入力したパスワードを確認または保存することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY는 입력한 암호를 확인하거나 저장하지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY 不會查看或儲存你輸入的密碼。"
          }
        }
      }
    },
