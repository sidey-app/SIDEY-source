          }
        }
      }
    },
    "store.footer.coming_soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is coming soon. You can keep using items you already own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアは準備中です。所有済みの商品は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 상점은 준비 중입니다. 보유 상품은 계속 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店即將推出。您仍可繼續使用已擁有的商品。"
          }
        }
      }
    },
    "store.footer.direct.entitlement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayed prices include tax. Access to digital customization items begins after server confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示価格は税込みです。サーバー確認後、デジタルカスタマイズ商品の利用権が開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 가격은 부가세 포함이며 서버 확인 뒤 디지털 꾸미기 사용권이 즉시 시작됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示價格含稅。伺服器確認後，即可使用數位自訂商品。"
          }
        }
      }
    },
    "store.footer.direct.refund": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-of-mind refunds aren’t available after access begins. Full refunds are provided where legally required, including non-delivery, mismatch, duplicate, or unauthorized payment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供開始後の自己都合による返金はできません。未提供、契約不一致、重複・不正決済など法定事由には全額返金します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공 시작 뒤 단순 변심 환불은 불가하며, 미제공·계약 불일치·중복·무단 결제 등 법정 사유는 전액 환불합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始提供後不接受因改變心意而退款；未提供、與合約不符、重複或未授權付款等法定情況可全額退款。"
          }
        }
      }
    },
