    "groups.current.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Manage the friends shown together and the active group. Each group can have up to %lld member."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Manage the friends shown together and the active group. Each group can have up to %lld members."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "一緒に表示する友だちと使用中のグループを管理できます。各グループには最大%lld人まで参加できます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "一緒に表示する友だちと使用中のグループを管理できます。各グループには最大%lld人まで参加できます。"
