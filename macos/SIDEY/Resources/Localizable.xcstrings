    "settings.display.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how friends’ status and messages appear on screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちの状態とメッセージが画面に表示される方法を調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 상태와 메시지가 화면에 나타나는 방식을 조절할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整朋友狀態與訊息在螢幕上的顯示方式。"
          }
        }
      }
    },
    "settings.display.throw_guard.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, you can click a friend’s character immediately. When on, you must double-right-click your character first, then click within 10 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると友だちのキャラクターをすぐクリックできます。オンにすると、自分のキャラクターを右ダブルクリックしてから10秒間だけクリックできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 친구 캐릭터를 바로 클릭할 수 있고, 켜면 내 캐릭터를 더블 우클릭한 뒤 10초 동안만 클릭할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時可直接點按朋友的角色；開啟時，必須先在自己的角色上按兩下右鍵，並在 10 秒內點按。"
          }
        }
      }
    },
    "settings.display.throw_guard.title": {
