        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 권한이 변경되어 실시간 연결을 새로 고쳐야 합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組權限已變更，需要重新整理即時連線。"
          }
        }
      }
    },
    "backend.realtime_recovery_failed": {
