    "backend.error.realtime_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The real-time connection isn’t ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム接続の準備ができていません。"
          }
