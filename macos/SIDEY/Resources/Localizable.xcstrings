        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the display for the pixel world. You can move the composer separately using its left handle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセルワールドを表示する画面を選びます。入力ウインドウは左側のハンドルで別に移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "픽셀 월드를 표시할 화면을 선택합니다. 입력창은 왼쪽 손잡이로 따로 이동할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要顯示像素世界的螢幕。輸入視窗可使用左側把手另外移動。"
          }
        }
