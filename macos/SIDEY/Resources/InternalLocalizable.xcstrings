{
  "sourceLanguage": "en",
  "strings": {
    "build_review.error.relaunch_instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it again with scripts/macos/open_current.sh, or build and run it from Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/macos/open_current.shで開き直すか、Xcodeでビルドして実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/macos/open_current.sh로 다시 열거나 Xcode에서 빌드 후 실행해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 scripts/macos/open_current.sh 重新開啟，或在 Xcode 中建置後執行。"
          }
        }
      }
    },
    "build_review.error.unverified_source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify that this app was built from the current source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のソースからビルドされたアプリか確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 소스로 빌드한 앱인지 확인할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認此 App 是否由目前的原始碼建置。"
          }
        }
      }
    },
    "common.quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束"
          }
        }
      }
    },
    "configuration.error.incomplete_environment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set both SIDEY_SUPABASE_URL and SIDEY_SUPABASE_PUBLISHABLE_KEY."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY_SUPABASE_URLとSIDEY_SUPABASE_PUBLISHABLE_KEYの両方を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY_SUPABASE_URL과 SIDEY_SUPABASE_PUBLISHABLE_KEY를 모두 설정해야 합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請同時設定 SIDEY_SUPABASE_URL 與 SIDEY_SUPABASE_PUBLISHABLE_KEY。"
          }
        }
      }
    },
    "configuration.error.missing_development_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev requires the SIDEY-staging URL and publishable key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-devにはSIDEY-stagingのURLとpublishable keyが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev에는 SIDEY-staging URL과 publishable key가 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev 需要 SIDEY-staging URL 與 publishable key。"
          }
        }
      }
    },
    "configuration.error.production_backend_in_development": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev can’t connect to the production Supabase project."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-devは本番環境のSupabaseプロジェクトに接続できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev는 production Supabase 프로젝트에 연결할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev 無法連線至正式環境的 Supabase 專案。"
          }
        }
      }
    },
    "configuration.error.secret_key_not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Supabase secret or service-role key can’t be used in the client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントではSupabaseのsecret/service-roleキーを使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트에 Supabase secret/service-role 키를 사용할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用戶端不可使用 Supabase secret/service-role 金鑰。"
          }
        }
      }
    },
    "configuration.error.unsupported_realtime_protocol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SIDEY real-time protocol setting contains an unsupported value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEYのリアルタイムプロトコル設定に対応していない値が指定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY 실시간 프로토콜 설정이 지원되지 않는 값입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SIDEY 即時通訊協定設定含有不支援的值。"
          }
        }
      }
    },
    "debug.build.dirty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncommitted changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未コミットの変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미커밋 변경"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交的變更"
          }
        }
      }
    },
    "store.review.capture_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store review · Capture failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストア確認・キャプチャ失敗"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상점 검토 · 캡처 실패"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店檢查 · 擷取失敗"
          }
        }
      }
    },
    "store.review.ownership": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ownership"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有状態"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有狀態"
          }
        }
      }
    },
    "store.review.ownership.all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者"
          }
        }
      }
    },
    "store.review.ownership.character": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Character only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャラクターのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐릭터만"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅角色"
          }
        }
      }
    },
    "store.review.ownership.keepsake": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keepsake only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건만"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅珍藏物"
          }
        }
      }
    },
    "store.review.ownership.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未所有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미보유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未擁有"
          }
        }
      }
    },
    "store.review.product": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상품"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商品"
          }
        }
      }
    },
    "store.review.purchase_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This review screen never makes real purchases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認用画面では実際の購入は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토용 화면에서는 실제 결제를 진행하지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查畫面不會進行實際購買。"
          }
        }
      }
    },
    "store.review.window.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev · Store review · No real purchases"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev・ストア確認・実購入なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev · 상점 검토 · 실제 결제 없음"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidey-dev · 商店檢查 · 不會實際購買"
          }
        }
      }
    }
  },
  "version": "1.0"
}
