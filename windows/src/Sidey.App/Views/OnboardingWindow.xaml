<Window
    x:Class="Sidey.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid x:Name="OnboardingRoot" Background="Transparent">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ResponsiveStates">
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SetupProgress.Margin" Value="24,16" />
            <Setter Target="SetupContent.Margin" Value="24,0" />
            <Setter Target="SetupFooter.Margin" Value="24,16,24,24" />
            <Setter Target="StepProfileLabel.Visibility" Value="Collapsed" />
            <Setter Target="StepGroupLabel.Visibility" Value="Collapsed" />
            <Setter Target="StepCompleteLabel.Visibility" Value="Collapsed" />
            <Setter Target="StepSeparatorOne.Width" Value="32" />
            <Setter Target="StepSeparatorOne.Margin" Value="8,0" />
            <Setter Target="StepSeparatorTwo.Width" Value="32" />
            <Setter Target="StepSeparatorTwo.Margin" Value="8,0" />
            <Setter Target="SetupConnectionStatus.(Grid.Row)" Value="1" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Standard">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="OnboardingFallbackBackground" Grid.RowSpan="2" Canvas.ZIndex="-1"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />

    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        Canvas.ZIndex="10"
        IsBackButtonVisible="False"
        IsPaneToggleButtonVisible="False"
        Title="{Binding Value, Source={i18n:I18n Key=window.settingsTitle}, Mode=OneWay}" />

    <Grid
        Grid.RowSpan="2"
        Background="{ThemeResource SideyOnboardingLandingBackgroundBrush}"
        Visibility="{Binding IsLanding, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Ellipse
          Width="360"
          Height="360"
          Margin="-160,-168,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Fill="{ThemeResource SideyOnboardingDecorationPrimaryBrush}" />
      <Ellipse
          Width="320"
          Height="320"
          Margin="0,0,-128,-152"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Fill="{ThemeResource SideyOnboardingDecorationSecondaryBrush}" />
      <ScrollViewer Margin="0,48,0,0" VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
      <StackPanel
          MaxWidth="560"
          Margin="32"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Spacing="16">
        <Border
            Width="132"
            Height="132"
            HorizontalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="32">
          <Image x:Name="LandingIcon" Margin="16" Stretch="Uniform" />
        </Border>
        <TextBlock
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            AutomationProperties.HeadingLevel="Level1"
            FontFamily="Segoe UI Variable Display, Segoe UI"
            FontSize="40"
            FontWeight="SemiBold"
            CharacterSpacing="64"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Text="SIDEY" />
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="Segoe UI Variable Display, Segoe UI"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="{Binding Value, Source={i18n:I18n Key=onboarding.tagline}, Mode=OneWay}" />
        <TextBlock
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="{Binding Value, Source={i18n:I18n Key=onboarding.googleDescription}, Mode=OneWay}" />
        <Button
            MinWidth="152"
            HorizontalAlignment="Center"
            AutomationProperties.Name="{Binding BeginLabel}"
            Command="{Binding BeginCommand}"
            Content="{Binding BeginLabel}"
            IsEnabled="{Binding CanBegin}"
            Style="{StaticResource AccentButtonStyle}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
            Visibility="{Binding IsGooglePending, Converter={StaticResource BooleanToVisibilityConverter}}"
            Text="{Binding Value, Source={i18n:I18n Key=onboarding.googlePending}, Mode=OneWay}" />
        <Button HorizontalAlignment="Center" Command="{Binding CancelGoogleCommand}"
            Visibility="{Binding IsGooglePending, Converter={StaticResource BooleanToVisibilityConverter}}"
            Content="{Binding Value, Source={i18n:I18n Key=onboarding.googleCancel}, Mode=OneWay}" />
        <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding ErrorMessage}" />
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid
        Grid.Row="1"
        Visibility="{Binding IsSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="SetupProgress" Margin="48,16,48,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" Text="1" />
          </Border>
          <TextBlock x:Name="StepProfileLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepProfile}, Mode=OneWay}" />
        </StackPanel>
        <Rectangle x:Name="StepSeparatorOne" Grid.Column="1" Width="72" Height="1" Margin="16,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" Text="2" />
          </Border>
          <TextBlock x:Name="StepGroupLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepGroup}, Mode=OneWay}" />
        </StackPanel>
        <Rectangle x:Name="StepSeparatorTwo" Grid.Column="3" Width="72" Height="1" Margin="16,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE73E;" />
          </Border>
          <TextBlock x:Name="StepCompleteLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepComplete}, Mode=OneWay}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="SetupContent" Grid.Row="1" Margin="40,0">
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel MaxWidth="648" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock
                  AutomationProperties.HeadingLevel="Level1"
                  FontFamily="Segoe UI Variable Display, Segoe UI"
                  FontSize="32"
                  FontWeight="SemiBold"
                  Text="{Binding Value, Source={i18n:I18n Key=onboarding.profileTitle}, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.profileDescription}, Mode=OneWay}" />
            </StackPanel>
            <Border Style="{StaticResource SideySettingsCardStyle}">
              <StackPanel Spacing="16">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.character}, Mode=OneWay}" />
                <GridView
                    x:Name="OnboardingCharacterSelector"
                    ItemsSource="{Binding CharacterSelections}"
                    SelectedValuePath="Id"
                    SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                    SelectionMode="Single">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" ItemWidth="116" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                  <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Margin" Value="0" />
                    </Style>
                  </GridView.ItemContainerStyle>
                  <GridView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="96">
                        <StackPanel Padding="8" Spacing="8">
                          <Border Width="48" Height="48" HorizontalAlignment="Center">
                            <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                          </Border>
                          <TextBlock HorizontalAlignment="Center" Text="{Binding DisplayName}" />
                        </StackPanel>
                        <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Grid>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
                <TextBox
                    Header="{Binding Value, Source={i18n:I18n Key=onboarding.nickname}, Mode=OneWay}"
                    MaxLength="8"
                    PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.nicknamePlaceholder}, Mode=OneWay}"
                    Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding SaveProfileCommand}"
                    Content="{Binding Value, Source={i18n:I18n Key=common.next}, Mode=OneWay}"
                    IsEnabled="{Binding CanSaveProfile}"
                    Style="{StaticResource AccentButtonStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            Visibility="{Binding IsGroupStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel MaxWidth="648" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock
                  AutomationProperties.HeadingLevel="Level1"
                  FontFamily="Segoe UI Variable Display, Segoe UI"
                  FontSize="32"
                  FontWeight="SemiBold"
                  Text="{Binding Value, Source={i18n:I18n Key=onboarding.groupTitle}, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.groupDescription}, Mode=OneWay}" />
            </StackPanel>
            <Border Style="{StaticResource SideySettingsCardStyle}">
              <StackPanel Spacing="20">
                <RadioButtons Header="{Binding Value, Source={i18n:I18n Key=onboarding.groupPath}, Mode=OneWay}" MaxColumns="2" SelectedIndex="{Binding GroupPathIndex, Mode=TwoWay}">
                  <RadioButton Content="{Binding Value, Source={i18n:I18n Key=onboarding.createPath}, Mode=OneWay}" />
                  <RadioButton Content="{Binding Value, Source={i18n:I18n Key=onboarding.joinPath}, Mode=OneWay}" />
                </RadioButtons>
                <StackPanel Spacing="12" Visibility="{Binding GroupPathIndex, Converter={StaticResource ZeroToVisibilityConverter}}">
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=onboarding.roomName}, Mode=OneWay}" MaxLength="20" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.roomNamePlaceholder}, Mode=OneWay}" Text="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.createDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  <Button HorizontalAlignment="Right" Command="{Binding CreateRoomCommand}" Content="{Binding Value, Source={i18n:I18n Key=onboarding.create}, Mode=OneWay}" IsEnabled="{Binding CanCreateRoom}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <StackPanel Spacing="12" Visibility="{Binding GroupPathIndex, Converter={StaticResource OneToVisibilityConverter}}">
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCode}, Mode=OneWay}" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCodePlaceholder}, Mode=OneWay}" Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCaseNotice}, Mode=OneWay}" />
                  <Button HorizontalAlignment="Right" Command="{Binding JoinRoomCommand}" Content="{Binding Value, Source={i18n:I18n Key=onboarding.join}, Mode=OneWay}" IsEnabled="{Binding CanJoinRoom}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel
            MaxWidth="600"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{Binding IsReadyStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Width="92" Height="92" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="46">
            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;" />
          </Border>
          <TextBlock
              HorizontalAlignment="Center"
              AutomationProperties.HeadingLevel="Level1"
              FontFamily="Segoe UI Variable Display, Segoe UI"
              FontSize="32"
              FontWeight="SemiBold"
              Text="{Binding Value, Source={i18n:I18n Key=onboarding.completeTitle}, Mode=OneWay}" />
          <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.completeDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
          <Button
              MinWidth="168"
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              Command="{Binding FinishCommand}"
              Content="{Binding Value, Source={i18n:I18n Key=onboarding.launch}, Mode=OneWay}"
              Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="SetupFooter" Grid.Row="2" Margin="40,16,40,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Button
            HorizontalAlignment="Left"
            Command="{Binding BackCommand}"
            Content="{Binding Value, Source={i18n:I18n Key=common.back}, Mode=OneWay}"
            Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel x:Name="SetupConnectionStatus" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
          <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionText}" />
        </StackPanel>
        <Button
            HorizontalAlignment="Right"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=common.skip}, Mode=OneWay}"
            Command="{Binding SkipGroupCommand}"
            Content="{Binding Value, Source={i18n:I18n Key=common.skip}, Mode=OneWay}"
            Visibility="{Binding IsGroupStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </Grid>
    </Grid>

    <InfoBar
        x:Name="GoogleSignInInfoBar"
        Grid.Row="1"
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        IsClosable="True"
        IsOpen="False"
        Message="{Binding Value, Source={i18n:I18n Key=auth.googleSignInComplete}, Mode=OneWay}"
        Severity="Success" />
    <InfoBar
        Grid.Row="1"
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        IsClosable="False"
        IsOpen="{Binding HasError}"
        Message="{Binding ErrorMessage}"
        Severity="Error" />
  </Grid>
</Window>
