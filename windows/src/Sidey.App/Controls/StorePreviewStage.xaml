<UserControl
    x:Class="Sidey.App.Controls.StorePreviewStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization"
    Width="540"
    Height="200">
  <Border
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="20">
    <Grid>
      <Canvas x:Name="SceneCanvas" Width="540" Height="200" Visibility="Collapsed">
        <Canvas x:Name="PlatformCanvas" Width="540" Height="24" Canvas.Top="176" IsHitTestVisible="False" />

        <StackPanel x:Name="LeftNameplate" Canvas.Top="100" Canvas.ZIndex="20" Orientation="Horizontal" Spacing="4">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
          <Border Height="20" Padding="4,0" Background="#9E050609" CornerRadius="8">
            <TextBlock Foreground="White" FontSize="12" Text="{Binding Value, Source={i18n:I18n Key=store.preview.member.moka}, Mode=OneWay}" />
          </Border>
        </StackPanel>
        <StackPanel x:Name="RightNameplate" Canvas.Top="100" Canvas.ZIndex="20" Orientation="Horizontal" Spacing="4">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
          <Border Height="20" Padding="4,0" Background="#9E050609" CornerRadius="8">
            <TextBlock Foreground="White" FontSize="12" Text="{Binding Value, Source={i18n:I18n Key=store.preview.member.dubu}, Mode=OneWay}" />
          </Border>
        </StackPanel>

        <Canvas
            x:Name="BubblePreview"
            Height="46"
            Canvas.Top="52"
            Visibility="Collapsed">
          <Border
              x:Name="BubbleBody"
              Height="28"
              BorderBrush="#2914171F"
              BorderThickness="1"
              CornerRadius="8">
            <Grid>
              <TextBlock
                  x:Name="BubbleText"
                  Margin="8,7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  TextAlignment="Center"
                  TextWrapping="NoWrap" />
            </Grid>
          </Border>
          <Image
              x:Name="BubbleDecoration"
              Width="32"
              Height="32"
              Stretch="None" />
          <Polygon
              x:Name="BubbleTail"
              Points="0,0 12,0 6,8" />
        </Canvas>

        <Grid x:Name="LeftCharacterHost" Width="72" Height="72" Canvas.Top="113" Background="Transparent" DoubleTapped="OnCharacterDoubleTapped" RightTapped="OnCharacterRightTapped">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="LeftCharacterScale" CenterX="36" CenterY="63" />
          </Grid.RenderTransform>
        </Grid>
        <Grid x:Name="RightCharacterHost" Width="72" Height="72" Canvas.Top="113" Background="Transparent" Tapped="OnFriendTapped">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="RightCharacterScale" CenterX="36" CenterY="36" />
          </Grid.RenderTransform>
        </Grid>
        <Canvas x:Name="SparkleCanvas" Width="540" Height="176" IsHitTestVisible="False">
          <Canvas.Clip><RectangleGeometry Rect="0,0,540,176" /></Canvas.Clip>
        </Canvas>
        <controls:PreloadedPixelAnimation x:Name="EmitterImage" Width="72" Height="72" Canvas.Top="113" Opacity="0" Canvas.ZIndex="21">
          <controls:PreloadedPixelAnimation.RenderTransform>
            <ScaleTransform x:Name="EmitterScale" CenterX="36" CenterY="36" />
          </controls:PreloadedPixelAnimation.RenderTransform>
        </controls:PreloadedPixelAnimation>
        <controls:PreloadedPixelAnimation x:Name="ProjectileImage" Width="48" Height="48" Opacity="0" Canvas.ZIndex="22">
          <controls:PreloadedPixelAnimation.RenderTransform>
            <ScaleTransform x:Name="ProjectileScale" CenterX="24" CenterY="24" />
          </controls:PreloadedPixelAnimation.RenderTransform>
        </controls:PreloadedPixelAnimation>
        <controls:PreloadedPixelAnimation x:Name="ImpactImage" Width="72" Height="72" Opacity="0" Canvas.ZIndex="22" />
      </Canvas>

      <TextBlock x:Name="TreeMovementHint" Margin="12,12,60,0" MaxWidth="400"
          HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="12" IsHitTestVisible="False"
          Text="{Binding Value, Source={i18n:I18n Key=store.preview.tree_movement_hint}, Mode=OneWay}" />
      <Button x:Name="PreviewSoundButton" Width="36" Height="36" Margin="12" Padding="0"
          HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnPreviewSoundClick">
        <SymbolIcon x:Name="PreviewSoundIcon" Symbol="Volume" />
      </Button>
      <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" />
      <TextBlock
          x:Name="ErrorText"
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
